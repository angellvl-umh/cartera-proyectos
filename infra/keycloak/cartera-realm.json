{
  "realm": "cartera",
  "enabled": true,
  "registrationAllowed": false,
  "clients": [
    {
      "clientId": "cartera-frontend",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost/*", "http://localhost:4200/*"],
      "webOrigins": ["http://localhost", "http://localhost:4200"],
      "protocol": "openid-connect",
      "attributes": {
        "post.logout.redirect.uris": "http://localhost/*##http://localhost:4200/*"
      }
    },
    {
      "clientId": "cartera-backend",
      "enabled": true,
      "bearerOnly": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "cartera-admin",
      "description": "Service account que usa el backend para crear usuarios locales (Admin API)",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "secret": "${KC_ADMIN_CLIENT_SECRET}"
    }
  ],
  "identityProviders": [
    {
      "alias": "google",
      "displayName": "Google",
      "providerId": "google",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "${GOOGLE_CLIENT_ID}",
        "clientSecret": "${GOOGLE_CLIENT_SECRET}",
        "syncMode": "IMPORT"
      }
    }
  ],
  "users": [
    {
      "username": "gestor",
      "email": "gestor@universidad.es",
      "firstName": "Ana",
      "lastName": "García",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "gestor123", "temporary": false }
      ]
    },
    {
      "username": "jefe",
      "email": "jefe@universidad.es",
      "firstName": "Carlos",
      "lastName": "López",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "jefe123", "temporary": false }
      ]
    },
    {
      "username": "dev",
      "email": "dev@universidad.es",
      "firstName": "María",
      "lastName": "Martínez",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "dev123", "temporary": false }
      ]
    },
    {
      "username": "service-account-cartera-admin",
      "enabled": true,
      "serviceAccountClientId": "cartera-admin",
      "clientRoles": {
        "realm-management": ["manage-users", "view-users", "query-users"]
      }
    }
  ]
}
