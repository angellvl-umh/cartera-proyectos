# AWS credentials for Bedrock (embeddings + LLM via LiteLLM)
# Copy this file to .env and fill in your values

# Config por entorno (local / Tailscale / producción) — ver infra/KEYCLOAK.md#config-por-entorno
# Origen público desde el que se accede al FRONTEND (el navegador del usuario)
#   Local (default):  http://localhost
#   Tailscale:         http://<nombre-tailscale>          (p.ej. http://mipc.tailnet-xxxx.ts.net)
#   Producción:        https://cartera.umh.es
PUBLIC_URL=http://localhost
# Origen público desde el que se accede a KEYCLOAK (el navegador del usuario)
#   Local (default):  http://localhost:8080
#   Tailscale:         http://<nombre-tailscale>:8080
#   Producción:        https://auth.umh.es  (o subruta, detrás de reverse proxy con TLS)
KEYCLOAK_PUBLIC_URL=http://localhost:8080

# Option A: Bearer token (AWS IAM Identity Center / SSO)
AWS_BEARER_TOKEN_BEDROCK=

# Option B: IAM access key + secret (leave empty if using bearer token)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

AWS_REGION=us-east-1

# Google IdP para Keycloak (infra/KEYCLOAK.md) — OAuth client ID/secret de Google Cloud Console
# Redirect URI a autorizar en Google Cloud Console:
#   http://localhost:8080/realms/cartera/broker/google/endpoint
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Secret del cliente cartera-admin en Keycloak (alta de credenciales locales) — change in production
KC_ADMIN_CLIENT_SECRET=cartera-admin-secret
