# AWS credentials for Bedrock (embeddings + LLM via LiteLLM)
# Copy this file to .env and fill in your values

# Option A: Bearer token (AWS IAM Identity Center / SSO)
AWS_BEARER_TOKEN_BEDROCK=

# Option B: IAM access key + secret (leave empty if using bearer token)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

AWS_REGION=us-east-1

# API key that Open WebUI uses to call the agent tool server
# Change in production
AGENT_API_KEY=cartera-agent-key

# Open WebUI session secret — change in production
WEBUI_SECRET_KEY=cartera-webui-secret-change-in-prod

# Google IdP para Keycloak (infra/KEYCLOAK.md) — OAuth client ID/secret de Google Cloud Console
# Redirect URI a autorizar en Google Cloud Console:
#   http://localhost:8080/realms/cartera/broker/google/endpoint
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Secret del cliente cartera-admin en Keycloak (alta de credenciales locales) — change in production
KC_ADMIN_CLIENT_SECRET=cartera-admin-secret
