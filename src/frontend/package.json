{
  "name": "cartera-proyectos-frontend",
  "version": "0.0.1",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "stack:e2e:up": "docker compose -f ../../docker-compose.yml -f ../../docker-compose.e2e.yml up -d --wait db keycloak backend frontend && pnpm stack:e2e:seed",
    "stack:e2e:seed": "docker compose -f ../../docker-compose.yml exec -T db psql -U postgres -d cartera_app -v ON_ERROR_STOP=1 < ../../infra/seed.sql",
    "stack:e2e:down": "docker compose -f ../../docker-compose.yml -f ../../docker-compose.e2e.yml down",
    "stack:up": "docker compose -f ../../docker-compose.yml up -d --wait db keycloak backend frontend"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.0.0",
    "@angular/cdk": "^21.0.0",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@ant-design/icons-angular": "^21.0.0",
    "angular-auth-oidc-client": "^19.0.0",
    "marked": "^18.0.9",
    "ng-zorro-antd": "^21.0.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.6.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@playwright/test": "^1.61.1",
    "typescript": "~5.9.0",
    "vitest": "^4.0.0"
  }
}
